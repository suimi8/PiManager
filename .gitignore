# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/
.env
.pytest_cache/
.tmp-pytest/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Local agent / secrets (never commit)
.agents/
.tmp-home/
.tmp-home-old/
**/.pi/
**/secrets.vault
**/secrets.dpapi
**/auth.json
**/.secrets.*
# vault 盐文件与 secrets.vault 同等敏感（SECURITY.md「回退 vault 的威胁模型」：
# pepper 随二进制公开，盐是剩余的全部保护）。此前不匹配上面任何一条规则。
**/.vault_master_key
**/secrets.index.json
# config_broker 的 broker token 是凭据等价物（扩展凭它调用 --config-mutate）
**/.broker-token
# Lock files (keep specific; avoid over-broad *.lock)
*.mutation.lock
*.broker.lock

# 子代理审查报告是过程产物，按 docs/DEVELOPMENT_STANDARDS.md §9.5「可归档不入库」
# 处理；此前无规则，一次 `git add .` 就会把它们全部提交进来。
docs/review/

# Local workbench & build artifacts (not part of the open-source tree)
work/
outputs/
build-*/
*.pid
*.log

# Root-level one-off patch/test scripts (not product source)
/test_*.txt
/_patch_*.py
/_fix*.py
/_gen_*.py
/_test_*.py

# PyInstaller
*.manifest
*.spec.bak
warn-*.txt
xref-*.html

# Node / VSIX packaging
node_modules/
*.vsix
release-assets/
# 扩展构建产物（保留 media 图标与源码）
extensions/**/out/
extensions/**/dist/
extensions/**/src/

# OS / sync noise
BaiduSyncdisk/
.SynologyWorkingDirectory/
~$*

# WorkBuddy agent local data (not part of the repo)
.workbuddy/
